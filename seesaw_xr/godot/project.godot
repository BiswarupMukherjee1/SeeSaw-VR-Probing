; See/Saw XR: Godot 4.7 project (Meta Quest 3 via OpenXR, desktop fallback when no headset is found)

config_version=5

[application]

config/name="SeeSaw XR"
config/description="See/Saw: probe ViT (DINOv2) attention from inside a 3D scene. Quest 3 + desktop fallback."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2

[xr]

openxr/enabled=true
openxr/startup_alert=false
shaders/enabled=true
